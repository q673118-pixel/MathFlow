<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@drawable/launcher_vanilla"
        android:roundIcon="@drawable/launcher_vanilla"
        android:label="MathFlow"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MathFlow.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="MathFlow configuration">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.mf" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.mf" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherVanilla"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/launcher_vanilla"
            android:label="MathFlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherBlack" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/launcher_black" android:label="MathFlow">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherWhite" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/launcher_white" android:label="MathFlow">
